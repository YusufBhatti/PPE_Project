+fi
+if test -z "${AMDEP_TRUE}" && test -z "${AMDEP_FALSE}"; then
+  as_fn_error $? "conditional \"AMDEP\" was never defined.
+Usually this means the macro was only invoked conditionally." "$LINENO" 5
+fi
+if test -z "${am__fastdepCC_TRUE}" && test -z "${am__fastdepCC_FALSE}"; then
+  as_fn_error $? "conditional \"am__fastdepCC\" was never defined.
+Usually this means the macro was only invoked conditionally." "$LINENO" 5
+fi
+case $FC_MODINC in #(
+  *\ ) FC_MODINC=$FC_MODINC'${ac_empty}' ;;
+esac
+if test -z "${BUILD_INTERNAL_YAXT_TRUE}" && test -z "${BUILD_INTERNAL_YAXT_FALSE}"; then
+  as_fn_error $? "conditional \"BUILD_INTERNAL_YAXT\" was never defined.
+Usually this means the macro was only invoked conditionally." "$LINENO" 5
+fi
+if test -z "${BUILD_INTERNAL_CDI_TRUE}" && test -z "${BUILD_INTERNAL_CDI_FALSE}"; then
+  as_fn_error $? "conditional \"BUILD_INTERNAL_CDI\" was never defined.
+Usually this means the macro was only invoked conditionally." "$LINENO" 5
+fi
+if test -z "${BUILD_INTERNAL_LAPACK_TRUE}" && test -z "${BUILD_INTERNAL_LAPACK_FALSE}"; then
+  as_fn_error $? "conditional \"BUILD_INTERNAL_LAPACK\" was never defined.
+Usually this means the macro was only invoked conditionally." "$LINENO" 5
+fi
