+                   if test "$use_mpi_compiler" = yes ; then
+                       mpi_version_number=$(lslpp -l ppe.poe | grep ppe.poe | uniq | awk '{print $2}')
+                       MPI_VERSION="IBM MPI ${mpi_version_number}"
+                   fi ;; @%:@(
+  sx?-nec-superux) :
+    
+                   mpi_version_number=$(strings $MPIROOT/lib/libmpi.a | grep "MPI/SX: library Version" | awk '{print $4}')
+                   MPI_VERSION="SX MPI ${mpi_version_number}" ;; @%:@(
+  *) :
+    MPI_VERSION=none ;;
+esac
+else $as_nop
+  case $host in @%:@(
+  *-*-darwin*) :
+    
+                   mpi_version_number=$(mpiexec --version | awk 'NR==2{print $2}')
+                   MPI_VERSION="mpich ${mpi_version_number} (MacPorts)" ;; @%:@(
+  *) :
+    
+                   MPI_VERSION="${MPIROOT##*/}"
+                ;;
+esac
+
+fi
+printf "%s\n" 
+printf "%s\n" "Selected compiler:"
+printf "%s\n" 
+
+printf "%s\n" "    Fortran   : $ax_fc_version"
+printf "%s\n" "    C         : $ax_cc_version"
+
+printf "%s\n" 
+printf "%s\n" "Selected libraries:"
+printf "%s\n" 
+
+printf "%s\n" "    MPI       : $MPI_VERSION"
+printf "%s\n" "                installation  $MPIROOT"
+
+if test x$NETCDFROOT = x
+then :
+  printf "%s\n" "    NETCDF    : none (error)"
+else $as_nop
+  printf "%s\n" "    NETCDF    : netcdf-$NETCDF_VERSION"
+       printf "%s\n" "                installation  $NETCDFROOT"
+fi
+
+if test x$NETCDFFROOT = x
+then :
+  printf "%s\n" "    NETCDFF   : none (error if NETCDF version >= 4.2)"
+else $as_nop
+  printf "%s\n" "    NETCDFF   : netcdff-$NETCDF_FVERSION"
+       printf "%s\n" "                installation  $NETCDFFROOT"
+fi
+
+if test x$HDF5ROOT = x
+then :
+  printf "%s\n" "    HDF5      : none (error)"
+else $as_nop
+  printf "%s\n" "    HDF5      : hdf5-$HDF5_VERSION"
+       printf "%s\n" "                installation  $HDF5ROOT"
+fi
+
+if test x$SZIPROOT = x
+then :
+  printf "%s\n" "    SZIP      : none (error)"
+else $as_nop
+  printf "%s\n" "    SZIP      : szip-$SZIP_VERSION"
+       printf "%s\n" "                installation  $SZIPROOT"
+fi
+
+if test x$ZLIBROOT = x
+then :
+  printf "%s\n" "    ZLIB      : none (error)"
+else $as_nop
+  printf "%s\n" "    ZLIB      : zlib-$ZLIB_VERSION"
+       printf "%s\n" "                installation  $ZLIBROOT"
+fi
+
+printf "%s\n" 
+
+if test x$CDIROOT = x
+then :
+  printf "%s\n" "    CDI       : none"
+else $as_nop
+  printf "%s\n" "    CDI       : cdi-$CDI_VERSION"
+       printf "%s\n" "                installation  $CDIROOT"
+fi
+
+if test x$YAXTROOT = x
+then :
+  printf "%s\n" "    YAXT      : none"
+else $as_nop
+  printf "%s\n" "    YAXT      : yaxt-$YAXT_VERSION"
+       printf "%s\n" "                installation  $YAXTROOT"
+fi
+
+if test x$SCTROOT = x
+then :
+  printf "%s\n" "    SCT       : none"
+else $as_nop
+  printf "%s\n" "    SCT       : $SCTROOT"
+fi
+
+if test $BUILD_INTERNAL_LAPACK = yes
+then :
+  printf "%s\n" "    LAPACK    : internal"
+else $as_nop
+  printf "%s\n" "    LAPACK    : $LAPACKROOT"
+fi
+
+printf "%s\n" 
+
+if test x$POSTGRESQLROOT = x
+then :
+  printf "%s\n" "    POSTGRESQL: none"
+else $as_nop
+  printf "%s\n" "    POSTGRESQL: postgresql-$POSTGRESQL_VERSION"
+       printf "%s\n" "                installation $POSTGRESQLROOT"
+fi
+
+printf "%s\n" 
+
+case $with_coupler in @%:@(
+  oasis3) :
+    printf "%s\n" "    OASIS3    : $OASIS3ROOT" ;; @%:@(
+  oasis3-mct) :
+    printf "%s\n" "    OASIS3-MCT: $OASIS3MCTROOT" ;; @%:@(
+  *) :
+    printf "%s\n" "    Coupling  : not enabled" ;;
+esac
+
+if test $FC = "pgfortran"
+then :
+  printf "%s\n" 
+       printf "%s\n" 'To prevent problems with pgfortran/libtool make sure'
+       printf "%s\n" '   @S|@HOME/.mypgfortranrc'
+       printf "%s\n" 'is available and is containing'
+       printf "%s\n" '   switch -pthread is replace@{:@-lpthread@:}@ positional@{:@linker@:}@;'     
+      
+fi
+
+printf "%s\n" 
+printf "%s\n" 'Configuration done. Run make (GNU make) to build ECHAM.'
+printf "%s\n" 
