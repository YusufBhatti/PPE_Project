&HAMMOZ_PERTURBATIONS
  scale_emi_dms            = 1.0 ! V_SCALE_EMI_DMS
  scale_emi_ant_bc         = 1.0 ! V_SCALE_EMI_ANT_BC
  scale_emi_ant_oc         = 1.0 ! V_SCALE_EMI_ANT_OC
  scale_emi_bb_so2         = 3.7 ! V_SCALE_EMI_BB_SO2
  scale_emi_bb_bc          = 3.7 ! V_SCALE_EMI_BB_BC
  scale_emi_bb_oc          = 3.7 ! V_SCALE_EMI_BB_OC
  scale_emi_ant_so2        = 1.0 ! V_SCALE_EMI_ANTH_SO2
  scale_emi_du             = 1.0 ! V_SCALE_EMI_DUST
  scale_ccraut             = 2.8 ! V_SCALE_CCRAUT
  scale_ccsaut             = 900.0 ! V_SCALE_CCSAUT
  scale_cprcon             = 0.0009 ! V_SCALE_CPRCON
  scale_entrpen            = 0.0002 ! V_SCALE_ENTRPEN
  KK_exponent             = -1.4 ! V_KK_EXPONENT
  KK_LWP_exponent         = 2.7 ! V_KK_LWP_EXPONENT
  scale_cmfctop            = 0.2 ! V_SCALE_CMFCTOP
  scale_micro_icefall      = 1.0 ! V_SCALE_MICRO_ICEFALL
  cld_cov_crs              = 0.975 ! V_CLD_COV_CRS
  cld_cov_crt              = 0.75 ! V_CLD_COV_CRT
  scale_entrscv            = 0.003 ! V_SCALE_ENTRSCV
  scale_entrmid            = 0.0001 ! V_SCALE_ENTRMID
  cld_opt_cinhomi          = 0.8 ! V_CLD_OPT_CINHOMI
  cld_opt_cinhoml1         = 0.8 ! V_CLD_OPT_CINHOML1
  cld_opt_cinhoml3         = 0.8 ! V_CLD_OPT_CINHOML3
  scale_emi_ss_acc         = 1.0 ! V_SCALE_EMI_SS_ACC
  scale_emi_ss_coarse      = 1.0 ! V_SCALE_EMI_SS_COARSE
  scale_seasalt_expo       = 1.1 ! V_SCALE_SEASALT_EXPO
  scale_emi_cmr_ff         = 3e-08 ! V_SCALE_EMI_CMR_FF
  scale_emi_cmr_bb         = 7.5e-08 ! V_SCALE_EMI_CMR_BB
  bc_rad_ni                = 0.71 ! V_SCALE_BC_RAD_NI
  du_rad_ni                = 0.001 ! V_SCALE_DU_RAD_NI
  oc_rad_ni                = 0.0055 ! V_SCALE_OC_RAD_NI
  scale_so2_reactions      = 1.0 ! V_SCALE_SO2_REACTIONS
  scale_dms_reactions      = 1.0 ! V_SCALE_DMS_REACTIONS
  scale_wetdep_ic          = 1.0 ! V_SCALE_WETDEP_IC
  scale_wetdep_bc          = 1.0 ! V_SCALE_WETDEP_BC
  scale_drydep_acc         = 1.0 ! V_SCALE_DRYDEP_ACC
  scale_so4_coating        = 1.0 ! V_SCALE_SO4_COATING
  kappa_so4                = 0.6 ! V_SCALE_KAPPA_SO4
  kappa_oc                 = 0.06 ! V_SCALE_KAPPA_OC
  scale_activation          = 1.0 ! V_SCALE_ACTIVATION
  scale_vertical_velocity  = 1.0 ! V_SCALE_VERTICAL_VELOCITY
  scale_nuc_ft             = 1.0 ! V_SCALE_NUC_FT


/
